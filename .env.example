# Copie para .env (não versionado). Estes valores servem SOMENTE para desenvolvimento local.
# Em qualquer outro ambiente, gere segredos próprios e injete-os pelo mecanismo de segredos da plataforma.

POSTGRES_DB=noxen_crm
POSTGRES_USER=noxen
POSTGRES_PASSWORD=noxen_dev_only

RABBITMQ_USER=noxen
RABBITMQ_PASSWORD=noxen_dev_only

# Perfil `app` (API e Worker em contêiner). Mínimo de 32 caracteres.
JWT_KEY=troque-esta-chave-de-desenvolvimento-por-uma-aleatoria-longa
ASPNETCORE_ENVIRONMENT=Production
DATABASE_MIGRATE_ON_STARTUP=false

# Primeiro Admin: usado só se ainda não existir nenhum usuário. Deixe vazio para não criar.
ADMIN_EMAIL=
ADMIN_PASSWORD=

CORS_ORIGIN=http://localhost:5173
